# Copy to .env with the development setup script. Never commit real credentials.
POINT_ENVIRONMENT=development
POINT_APP_NAME=POINT TODO EN UNO
POINT_DEFAULT_LOCALE=es-MX
POINT_DEFAULT_CURRENCY=MXN
POINT_DEFAULT_TIMEZONE=America/Mexico_City
POINT_DATABASE_URL=postgresql+psycopg://point:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:55432/point_dev
POINT_CORS_ORIGINS=["http://127.0.0.1:5173"]
POINT_LOG_LEVEL=INFO
POSTGRES_USER=point
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_ADMIN_PASSWORD
POSTGRES_DB=point_dev
POSTGRES_PORT=55432
POINT_WEB_PORT=5173
POINT_API_PORT=8000
