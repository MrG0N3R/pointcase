FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY apps/api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && useradd --uid 10001 --create-home point
COPY --chown=point:point apps/api/ /app/
USER point
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "point.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]

FROM base AS tests
USER root
RUN pip install --no-cache-dir -r /app/requirements-dev.txt
USER point
CMD ["python", "-m", "pytest", "-q"]

FROM base AS runtime
